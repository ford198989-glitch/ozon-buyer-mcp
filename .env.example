# stdio for local MCP clients; streamable-http for a private network endpoint
OZON_TRANSPORT=stdio
OZON_HOST=0.0.0.0
OZON_PORT=8084
OZON_MCP_PATH=/mcp

# Browser
OZON_HEADLESS=0
OZON_CHALLENGE_WAIT_MS=12000
OZON_BROWSER_TIMEOUT_MS=90000

# Optional outbound proxy for Ozon traffic.
# Examples:
# OZON_PROXY_SERVER=http://host:port
# OZON_PROXY_USERNAME=username
# OZON_PROXY_PASSWORD=password
# OZON_PROXY_BYPASS=localhost,127.0.0.1
OZON_PROXY_SERVER=
OZON_PROXY_USERNAME=
OZON_PROXY_PASSWORD=
OZON_PROXY_BYPASS=

# Optional remote browser worker. When set, Ozon browser traffic is executed
# on the remote worker instead of Railway.
OZON_REMOTE_WORKER_URL=
OZON_REMOTE_WORKER_TOKEN=

# Local worker settings
OZON_WORKER_HOST=127.0.0.1
OZON_WORKER_PORT=8765
OZON_WORKER_TOKEN=
